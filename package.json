{
  "name": "pi-simple-goal",
  "version": "1.1.3",
  "description": "Persistent autonomous goals for pi, with an error brake (fork of pi-goal 0.1.7, MIT)",
  "type": "commonjs",
  "keywords": [
    "pi",
    "pi-package",
    "goal",
    "automation",
    "error-backoff"
  ],
  "files": [
    ".pi/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/pi-simple-goal"
    ],
    "skills": [
      "skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  },
  "scripts": {
    "check": "pi --no-extensions -e ./.pi/extensions/pi-simple-goal/index.ts --list-models __pi_goal_load_check__",
    "test": "node --test test/**/*.test.cjs",
    "pack:dry": "npm pack --dry-run"
  },
  "author": "michaelliv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarSond/pi-simple-goal.git"
  }
}
